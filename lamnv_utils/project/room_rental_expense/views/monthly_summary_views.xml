<odoo>
    <record id="view_room_monthly_summary_form" model="ir.ui.view">
        <field name="name">room.monthly.summary.form</field>
        <field name="model">room.monthly.summary</field>
        <field name="arch" type="xml">
            <form string="Tổng Kết Chi Phí Tháng">
                <sheet>
                    <group>
                        <field name="month"/>
                        <field name="room_id" placeholder="Để trống để xem tất cả phòng"/>
                    </group>
                    <field name="summary" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_room_monthly_summary" model="ir.actions.act_window">
        <field name="name">Tổng Kết Tháng</field>
        <field name="res_model">room.monthly.summary</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
